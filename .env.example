# AI Waves — приклад конфігурації. Скопіюйте у .env:  cp .env.example .env

# --- Сервер ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Публічна адреса сайту (для Open Graph, посилань у вебхуках та Secure-cookie).
# Для Cloudflare Tunnel — ваш домен із https.
BASE_URL=https://music.example.com

# Cookie з токеном позначається Secure автоматично, якщо BASE_URL починається з https://.
# Змініть вручну лише якщо потрібно інакше (true / false).
# COOKIE_SECURE=true

# Скільки проксі стоїть перед застосунком (cloudflared = 1). Потрібно для коректного IP у rate-limit.
TRUST_PROXY=1

# Додаткові дозволені Origin для POST/PUT/DELETE (через кому), зазвичай не потрібно.
# ALLOWED_ORIGINS=https://music.example.com

# --- Безпека ---
# Секрет для підпису JWT: щонайменше 24 символи. Згенерувати: openssl rand -hex 32
# Якщо не задати — сервер створить випадковий і збереже в data/.jwt_secret.
JWT_SECRET=change-me-to-a-long-random-string

# Перший адміністратор створюється при старті, якщо в базі ще немає жодного адміна.
# Якщо пароль не задано (або це "change-me"), сервер згенерує його й виведе в лог ОДИН раз.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# --- Файли ---
# Cloudflare (безкоштовний тариф) обмежує тіло запиту ~100 МБ, тому тримайте ліміт нижче.
MAX_AUDIO_MB=90
MAX_COVER_MB=10

# Шляхи (у Docker вже змонтовані як томи /app/data та /app/uploads)
# DATA_DIR=/app/data
# UPLOAD_DIR=/app/uploads

# --- Брендинг ---
SITE_NAME=AI Waves

# --- Cloudflare Tunnel (використовується docker-compose.yml) ---
# Токен створюється в Cloudflare Zero Trust → Networks → Tunnels.
# Public hostname тунелю: music.example.com → http://app:3000
TUNNEL_TOKEN=
